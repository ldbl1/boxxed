<%- include('../partials/header') %>
<h2><%= t('newCategoryTitle') %></h2>
<div class="card">
    <form method="POST" action="/categories" enctype="multipart/form-data">
        <label><%= t('categoryName') %> (<%= t('categoryExample') %>)</label>
        <input type="text" name="name" required>

        <label for="category-image"><%= t('image') %></label>
        <input id="category-image" type="file" name="image" accept="image/*">
        <div class="upload-preview" data-upload-preview></div>
        
        <label><%= t('belongsTo') %></label>
        <div class="hierarchy-select">
            <select name="parent_id" class="hierarchy-select-native" aria-hidden="true" tabindex="-1">
                <option value=""><%= t('mainCategory') %></option>
                <% categories.forEach(function(cat) { %>
                    <option value="<%= cat.id %>" data-full-path="<%= cat.fullPath %>"><%= cat.name %></option>
                <% }); %>
            </select>
            <button type="button" class="hierarchy-select-button" aria-haspopup="listbox" aria-expanded="false"></button>
            <div class="hierarchy-select-menu" role="listbox" hidden>
                <button type="button" class="hierarchy-select-option" data-value=""><%= t('mainCategory') %></button>
                <% categories.forEach(function(cat) { %>
                    <button type="button" class="hierarchy-select-option" data-value="<%= cat.id %>" data-label="<%= cat.fullPath %>" data-depth="<%= cat.depth %>"><%= cat.name %></button>
                <% }); %>
            </div>
        </div>
        
        <button type="submit" class="btn"><%= t('save') %></button>
        <a href="/categories" class="btn btn-secondary"><%= t('cancel') %></a>
    </form>
</div>
<%- include('../partials/footer') %>