<%- include('../partials/header') %>
    <h2><%= t('newItemTitle') %></h2>
    <div class="card">
        <form method="POST" action="/items" enctype="multipart/form-data">
            <label><%= t('itemName') %></label>
            <input type="text" name="name" required placeholder="<%= t('itemExample') %>">

            <label for="item-image"><%= t('images') %></label>
            <input id="item-image" type="file" name="images" accept="image/*" multiple>
            <div class="upload-preview" data-upload-preview></div>

            <label><%= t('location') %></label>
            <div class="hierarchy-field hierarchy-native-field">
                <div class="hierarchy-preview" data-hierarchy-preview hidden>
                    <img data-hierarchy-image alt="<%= t('selectedLocation') %>">
                    <span class="hierarchy-image-placeholder" data-hierarchy-placeholder><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
                </div>
                <select name="location_id" data-hierarchy-native-select>
                    <option value=""><%= t('rootUnassigned') %></option>
                    <% locations.forEach(function(loc) { %>
                        <option value="<%= loc.id %>" data-image="<%= loc.image || '' %>" data-icon="bi-geo-alt"><%- '&nbsp;'.repeat(loc.depth * 4) %><%= loc.name %></option>
                    <% }); %>
                </select>
            </div>

            <label><%= t('category') %></label>
            <div class="hierarchy-field hierarchy-native-field">
                <div class="hierarchy-preview" data-hierarchy-preview hidden>
                    <img data-hierarchy-image alt="<%= t('category') %>">
                    <span class="hierarchy-image-placeholder" data-hierarchy-placeholder><i class="bi bi-tag" aria-hidden="true"></i></span>
                </div>
                <select name="category_id" data-hierarchy-native-select>
                    <option value=""><%= t('rootUnassigned') %></option>
                    <% categories.forEach(function(cat) { %>
                        <option value="<%= cat.id %>" data-image="<%= cat.image || '' %>" data-icon="bi-tag"><%- '&nbsp;'.repeat(cat.depth * 4) %><%= cat.name %></option>
                    <% }); %>
                </select>
            </div>
            <label><%= t('quantity') %></label>
            <input type="number" name="quantity" value="1" min="1" required>

            <button type="submit" class="btn"><%= t('save') %></button>
            <a href="/items" class="btn btn-secondary"><%= t('cancel') %></a>
        </form>
    </div>
    <%- include('../partials/footer') %>