<!DOCTYPE html>
<html lang="<%= language %>">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Boxxed</title>
    <link rel="icon" href="/logo.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/css/app.css">
    <style>:root { --accent-color: <%= settings.accentColor %>; --accent-strong: <%= accentStrong %>; }</style>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>

<body>
    <div class="app-container">
        <header class="mobile-brand">
            <a href="/items"><img src="/logo.svg" alt="Boxxed"><span>Boxxed</span></a>
        </header>
        <nav class="main-nav">
            <a class="brand-link" href="/items"><img src="/logo.svg" alt="Boxxed"><span>Boxxed</span></a>
            <a href="/items"><i class="bi bi-box-seam" aria-hidden="true"></i> <%= t('items') %></a>
            <a href="/locations"><i class="bi bi-geo-alt" aria-hidden="true"></i> <%= t('locations') %></a>
            <a href="/categories"><i class="bi bi-tags" aria-hidden="true"></i> <%= t('categories') %></a>
            <a href="/settings"><i class="bi bi-sliders" aria-hidden="true"></i> <%= t('settings') %></a>
        </nav>
        <main class="content">